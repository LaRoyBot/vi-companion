{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "vi-companion": {
      "type": "streamable-http",
      "url": "https://vi-companion.vercel.app/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "mixed",
            "client": {
              "mode": "dcr"
            },
            "resource": "https://vi-companion.vercel.app/mcp",
            "baseScopes": [
              "openid",
              "email",
              "profile"
            ],
            "oidcEnabled": true,
            "oidcConfigurationUrl": "https://ixjbqsviiesrgpnjwvvy.supabase.co/auth/v1/.well-known/openid-configuration",
            "oidcUserinfoEndpoint": "https://ixjbqsviiesrgpnjwvvy.supabase.co/auth/v1/oauth/userinfo",
            "oidcScopesSupported": [
              "openid",
              "email",
              "profile"
            ]
          }
        }
      }
    }
  }
}
